{
    "name": "nowo-tech/transaction-doctrine",
    "description": "Safe plain-Doctrine default for nowo-tech/transaction-contract: a one-attempt TransactionRunnerInterface that never leaves a poisoned connection (close instead of a failing rollback after a nested deadlock), the transient-failure classifier and connection repairer, and write units that replay a deadlock or lock wait timeout. Optional Symfony bundle: #[AsWriteUnit], Messenger middleware, 409 + Retry-After conflict responder, worker connection hygiene.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "doctrine",
        "dbal",
        "orm",
        "transaction",
        "deadlock",
        "savepoint",
        "worker",
        "frankenphp",
        "symfony",
        "write-unit"
    ],
    "homepage": "https://github.com/nowo-tech/transaction-doctrine",
    "support": {
        "issues": "https://github.com/nowo-tech/transaction-doctrine/issues",
        "source": "https://github.com/nowo-tech/transaction-doctrine",
        "docs": "https://github.com/nowo-tech/transaction-doctrine#documentation"
    },
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Developer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "doctrine/dbal": "^3.8.2 || ^4.0",
        "nowo-tech/transaction-contract": "^1.1",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "doctrine/orm": "^3.0",
        "doctrine/persistence": "^3.1 || ^4.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "igor-php/igor-php": "^0.10.0 || ^0.11.0",
        "nowo-tech/phpstan-frankenphp": "^1.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "rector/rector": "^2.0",
        "symfony/clock": "^6.4 || ^7.0 || ^8.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/messenger": "^6.4 || ^7.0 || ^8.0",
        "symfony/property-access": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-core": "^6.4 || ^7.0 || ^8.0",
        "symfony/serializer": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.0"
    },
    "conflict": {
        "symfony/http-kernel": "<6.4",
        "symfony/messenger": "<6.4"
    },
    "autoload": {
        "psr-4": {
            "Nowo\\TransactionDoctrine\\": "src/",
            "Nowo\\TransactionDoctrine\\WriteUnit\\Dbal\\Dbal3\\": "compat/dbal3/"
        },
        "files": [
            "aliases.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Nowo\\TransactionDoctrine\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit --color=always",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "rector-dry": "rector process --dry-run --no-progress-bar",
        "test-coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --colors=always --coverage-text --coverage-clover coverage.xml",
        "rector": "rector process --no-progress-bar",
        "igor": "igor-php --no-agent .",
        "qa": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "cs-check": "Check code style with PHP-CS-Fixer",
        "cs-fix": "Fix code style with PHP-CS-Fixer",
        "phpstan": "Run PHPStan static analysis",
        "rector-dry": "Run Rector in dry-run mode",
        "test-coverage": "Run PHPUnit with code coverage (text + Clover)",
        "rector": "Apply Rector refactoring",
        "igor": "Run Igor FrankenPHP worker-state audit (REQ-CS-008)",
        "qa": "Run all quality assurance checks"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.10.x-dev"
        }
    },
    "suggest": {
        "doctrine/orm": "For DoctrineTransactionRunner::forEntityManager() and write units on entity managers",
        "doctrine/persistence": "To reset a closed entity manager through a ManagerRegistry (required by WriteUnit)",
        "symfony/http-kernel": "For the optional NowoTransactionDoctrineBundle (#[AsWriteUnit], 409 conflict responder, worker hygiene)",
        "symfony/messenger": "For WriteUnitMiddleware (replays a consumed message after a lock conflict)",
        "psr/event-dispatcher": "To dispatch WriteUnitRetryEvent before each write-unit replay (Symfony's event_dispatcher)",
        "symfony/clock": "To pause between write-unit attempts through the Symfony clock (testable)",
        "twig/twig": "For the branded HTML conflict page (overridable template)",
        "nowo-tech/ui-kit-bundle": "The conflict page extends UiKit's error page when UiKit is installed"
    },
    "archive": {
        "exclude": [
            "/demo",
            "/.cursor",
            "/.specify",
            "/specs",
            "/tests",
            "/.github",
            "/.githooks",
            "/.scripts",
            "/Dockerfile",
            "/docker-compose.yml",
            "/Makefile",
            "/igor.json",
            "/.editorconfig",
            "/.cursorignore"
        ]
    }
}
