{#
  nowo-tech/transaction-doctrine: the answer to a write that met a database lock conflict on each attempt (409 by
  default, or 503 with conflict_response.status) — "Someone else was saving at the same moment" with *Try again*.
  Rendered by Nowo\TransactionDoctrine\Symfony\EventListener\ConcurrencyConflictResponder.

  Variables: status_code (409 | 503), retry_url (the page itself for a GET, else the same-host referer, else home),
  retry_after (seconds, or null), ui_kit (whether @NowoUiKit/error/status.html.twig exists), partial (true when part
  of the change was already committed: the conflict.partial.* texts, "reload before trying again", no Retry-After).

  Override: templates/bundles/NowoTransactionDoctrineBundle/conflict.html.twig, or conflict_response.template.
  Texts: translation domain nowo_transaction_doctrine (conflict.title | lead | hint | retry, and conflict.partial.*).
#}
{% set _p = partial|default(false) ? 'conflict.partial.' : 'conflict.' %}
{% if ui_kit %}
    {{- include('@NowoTransactionDoctrine/conflict_ui_kit.html.twig') -}}
{% else %}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ status_code }} — {{ (_p ~ 'title')|trans({}, 'nowo_transaction_doctrine') }}</title>
</head>
<body>
    <main data-testid="concurrency-conflict">
        <h1>{{ (_p ~ 'title')|trans({}, 'nowo_transaction_doctrine') }}</h1>
        <p>{{ (_p ~ 'lead')|trans({}, 'nowo_transaction_doctrine') }}</p>
        <p>{{ (_p ~ 'hint')|trans({}, 'nowo_transaction_doctrine') }}</p>
        <p><a href="{{ retry_url }}" data-testid="concurrency-conflict-retry">{{ (_p ~ 'retry')|trans({}, 'nowo_transaction_doctrine') }}</a></p>
    </main>
</body>
</html>
{% endif %}
